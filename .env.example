# Required for Docker Compose
SECRET_KEY=replace-with-a-long-random-secret-at-least-32-characters
POSTGRES_PASSWORD=replace-with-a-strong-database-password
NEXT_PUBLIC_APP_URL=http://localhost:3000
FRONTEND_ORIGINS=http://localhost:3000

# Optional external AI providers (never commit real keys)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-haiku-latest

# Optional data-source connector. Keep disabled unless host allowlist and read-only account are prepared.
ALLOW_REMOTE_DATABASE_CONNECTORS=false
REMOTE_DB_ALLOWED_HOSTS=

MAX_UPLOAD_MB=50
MAX_ROWS=250000
MAX_COLUMNS=500
